# --- LLM ---
# Path to a fine-tuned LoRA adapter. Leave empty to use the base model.
LORA_ADAPTER_PATH=
# Base model. gemma-2-2b-it is recommended for student GPUs (also works on CPU very slowly).
BASE_MODEL=google/gemma-2-2b-it
# If set, backend uses HF Inference API instead of loading weights locally (great for demo without GPU).
HF_API_TOKEN=
USE_HF_INFERENCE_API=false

# --- Real-time APIs ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
OPENWEATHERMAP_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
CHROMA_DIR=./chroma_db
LOG_LEVEL=INFO
